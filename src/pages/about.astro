---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';

const products = [
	{
		name: 'LabourGuard',
		description: 'A workforce compliance platform that helps businesses manage employee records, work permits, document expiries, compliance risks and inspection-ready reports.',
		href: '/labourguard',
		accent: 'blue',
		label: 'Workforce compliance',
	},
	{
		name: 'PowerGuard',
		description: 'powerGuard is a generator hire, LP gas and backup power service offering generator hire, LP gas supply, backup power support, repairs and maintenance for homes, events and businesses.',
		href: '/powerguard',
		accent: 'emerald',
		label: 'Generator hire and backup power',
	},
];

const services = [
	['Business websites', 'M4 5h16v14H4zM4 9h16M7 7h.01M10 7h.01'],
	['Custom software', 'm8 9-4 3 4 3m8-6 4 3-4 3m-5-8-2 10'],
	['Hosting and domains', 'M5 5h14v5H5zM5 14h14v5H5zM8 7.5h.01M8 16.5h.01M16 7.5h1M16 16.5h1'],
	['Business email', 'M3 6h18v12H3zM3 7l9 6 9-6'],
	['Cloud setup', 'M7 18h10a4 4 0 0 0 .5-7.97A6 6 0 0 0 6.2 8.5 4.5 4.5 0 0 0 7 18Z'],
	['Technical consulting', 'M12 3a7 7 0 0 0-4 12.74V20h8v-4.26A7 7 0 0 0 12 3Zm-3 13h6M9 20h6'],
];

const values = [
	{ title: 'Solve real problems', description: 'We focus on business outcomes before choosing the technology.' },
	{ title: 'Keep it simple', description: 'Good software should make daily work clearer, not more complicated.' },
	{ title: 'Build for the long term', description: 'We create solutions that can grow with the business and remain understandable over time.' },
	{ title: 'Work transparently', description: 'We keep decisions clear, explain trade-offs and work closely with clients.' },
];
---

<MainLayout title="About | Matome SoftTech Solutions" description="Learn how Matome SoftTech Solutions builds practical digital products, websites and software for real South African business challenges.">
	<PageHero eyebrow="About Matome SoftTech" title="Building practical software for real South African business challenges." description="We help growing businesses replace scattered records, manual processes and disconnected tools with focused digital solutions that are easier to manage, support and grow." primaryLabel="Work With Us" primaryHref="/contact" secondaryLabel="View Our Services" secondaryHref="/services">
		<div class="absolute inset-x-0 top-1/2 mx-auto w-[90%] max-w-[480px] -translate-y-1/2 rotate-[3deg] rounded-[2rem] border border-white/60 bg-white p-7 text-[#041B4D] shadow-[0_35px_80px_rgba(3,39,65,.35)] sm:p-10">
			<span class="grid size-14 place-items-center rounded-2xl bg-gradient-to-br from-[#0E5CFF] to-[#19B5FF] text-white"><svg viewBox="0 0 24 24" class="size-8" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 17V7l7 5 7-5v10M8 17h8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
			<p class="mt-8 text-xs font-black uppercase tracking-[.18em] text-[#0E5CFF]">Our mission</p>
			<p class="mt-3 text-2xl font-black leading-tight sm:text-3xl">Make powerful technology practical, useful and accessible for businesses ready to grow.</p>
		</div>
	</PageHero>

	<section class="py-20 sm:py-28">
		<div class="section-shell grid gap-12 lg:grid-cols-[.82fr_1.18fr] lg:items-center">
			<div><p class="eyebrow text-[#0E5CFF]">Our story</p><h2 class="mt-4 text-4xl font-black tracking-[-.035em] text-[#041B4D] sm:text-5xl">Built from real-world software experience.</h2></div>
			<div class="space-y-5 text-lg leading-8 text-slate-600"><p>Matome SoftTech Solutions was founded with a simple belief: technology should solve real operational problems, not create more complexity.</p><p>Our work is shaped by hands-on experience building business systems, workforce tools, reporting workflows and digital platforms used in everyday operations. That experience led to a clear focus: create software that helps businesses manage important work with more visibility, structure and confidence.</p></div>
		</div>
	</section>

	<section class="relative isolate overflow-hidden bg-gradient-to-br from-[#041B4D] via-[#073E9F] to-[#0E5CFF] py-20 text-white sm:py-28">
		<div class="absolute inset-0 -z-10 opacity-20" aria-hidden="true"><svg viewBox="0 0 1440 520" class="h-full w-full" preserveAspectRatio="none" fill="none"><circle cx="1250" cy="10" r="300" stroke="white"/><circle cx="1250" cy="10" r="210" stroke="white"/><path d="M0 420c300-150 520 80 810-45 240-105 430-80 630-35" stroke="white"/></svg></div>
		<div class="section-shell grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:items-center">
			<div><p class="eyebrow text-cyan-300">Why we exist</p><h2 class="mt-4 text-4xl font-black tracking-[-.035em] sm:text-5xl">Why Matome SoftTech exists</h2></div>
			<div class="space-y-5 text-lg leading-8 text-blue-50"><p>Many growing businesses still rely on spreadsheets, paper records, WhatsApp messages and disconnected files to manage critical information. That becomes risky when teams grow, documents expire, operations expand or managers need reliable reports.</p><p>Matome SoftTech Solutions exists to close that gap with practical products and services built around real business needs.</p></div>
		</div>
	</section>

	<section class="bg-gradient-to-b from-white to-blue-50/50 py-20 sm:py-28">
		<div class="section-shell">
			<div class="mx-auto max-w-3xl text-center"><p class="eyebrow text-[#0E5CFF]">Product-led by design</p><h2 class="mt-4 text-4xl font-black tracking-[-.035em] text-[#041B4D] sm:text-5xl">Our products are built around real operational pain points.</h2></div>
			<div class="mt-14 grid gap-6 lg:grid-cols-2">
				{products.map((product) => {
					const blue = product.accent === 'blue';
					return <article class:list={['group overflow-hidden rounded-3xl border bg-white p-7 shadow-[0_16px_45px_rgba(15,23,42,.08)] transition hover:-translate-y-1 hover:shadow-2xl sm:p-9', blue ? 'border-blue-100 hover:shadow-blue-100' : 'border-emerald-100 hover:shadow-emerald-100']}>
						<div class="flex items-center justify-between gap-4"><span class:list={['grid size-12 place-items-center rounded-2xl text-white shadow-lg', blue ? 'bg-gradient-to-br from-[#0E5CFF] to-[#19B5FF] shadow-blue-200' : 'bg-gradient-to-br from-emerald-400 to-emerald-700 shadow-emerald-200']}><svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">{blue ? <path d="M12 3 4.5 6v5.5c0 4.7 3.2 7.8 7.5 9.5 4.3-1.7 7.5-4.8 7.5-9.5V6L12 3Zm-3 9 2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/> : <path d="m13 2-8 12h6l-1 8 9-13h-6V2Z" stroke-linecap="round" stroke-linejoin="round"/>}</svg></span><span class:list={['rounded-full px-3 py-1.5 text-[10px] font-extrabold uppercase tracking-wider', blue ? 'bg-blue-50 text-blue-700' : 'bg-emerald-50 text-emerald-700']}>{product.label}</span></div>
						<h3 class:list={['mt-7 text-3xl font-black tracking-tight', blue ? 'text-[#0E5CFF]' : 'text-emerald-700']}>{product.name}</h3>
						<p class="mt-4 leading-7 text-slate-600">{product.description}</p>
						<a href={product.href} class:list={['mt-7 inline-flex items-center gap-2 text-sm font-extrabold', blue ? 'text-[#0E5CFF]' : 'text-emerald-700']}>Explore {product.name}<svg viewBox="0 0 24 24" class="size-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
					</article>;
				})}
			</div>
		</div>
	</section>

	<section class="py-20 sm:py-28">
		<div class="section-shell grid gap-12 lg:grid-cols-[.7fr_1.3fr] lg:items-center">
			<div><p class="eyebrow text-[#0E5CFF]">Services</p><h2 class="mt-4 text-4xl font-black tracking-[-.035em] text-[#041B4D]">We also help businesses build and run their digital presence.</h2><p class="mt-5 leading-7 text-slate-600">Alongside our products, we support businesses with websites, custom software and the technical foundations needed to operate online.</p><a href="/services" class="mt-7 inline-flex items-center gap-2 text-sm font-extrabold text-[#0E5CFF]">View our services<svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div>
			<div class="grid gap-4 sm:grid-cols-2">{services.map(([label, path]) => <article class="flex items-center gap-4 rounded-2xl border border-blue-100 bg-blue-50/60 p-5"><span class="grid size-11 shrink-0 place-items-center rounded-xl bg-white text-[#0E5CFF] shadow-sm"><svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={path}/></svg></span><h3 class="text-sm font-black text-[#041B4D]">{label}</h3></article>)}</div>
		</div>
	</section>

	<section class="bg-blue-50/60 py-20 sm:py-28">
		<div class="section-shell"><div class="max-w-3xl"><p class="eyebrow text-[#0E5CFF]">What guides us</p><h2 class="mt-4 text-4xl font-black tracking-[-.035em] text-[#041B4D] sm:text-5xl">How we approach the work.</h2></div><div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">{values.map((value, index) => <article class="rounded-3xl border border-blue-100 bg-white p-7 shadow-sm"><span class="text-xs font-black tracking-widest text-[#0E5CFF]">0{index + 1}</span><h3 class="mt-6 text-xl font-black text-[#041B4D]">{value.title}</h3><p class="mt-4 leading-7 text-slate-600">{value.description}</p></article>)}</div></div>
	</section>

	<section class="py-20 sm:py-28">
		<div class="section-shell">
			<div class="relative isolate overflow-hidden rounded-3xl bg-gradient-to-r from-[#041B4D] via-[#0E5CFF] to-[#19B5FF] px-6 py-14 text-white shadow-2xl shadow-blue-200 sm:px-10 lg:px-14">
				<div class="absolute inset-0 -z-10 opacity-20" aria-hidden="true"><svg viewBox="0 0 1200 300" class="h-full w-full" preserveAspectRatio="none" fill="none"><circle cx="1090" cy="20" r="190" stroke="white"/><path d="M0 245c280-145 490 70 750-40 190-80 320-75 450-40" stroke="white"/></svg></div>
				<div class="grid items-center gap-8 lg:grid-cols-[1fr_auto]"><div><p class="eyebrow text-cyan-200">Start a conversation</p><h2 class="mt-4 text-3xl font-black tracking-[-.03em] sm:text-4xl">Ready to build something practical?</h2><p class="mt-4 max-w-2xl text-lg leading-8 text-blue-50">Let’s discuss your website, software idea, LabourGuard demo or PowerGuard enquiry.</p></div><a href="/contact" class="group inline-flex items-center justify-center gap-3 rounded-full bg-[#041B4D] px-8 py-4 text-sm font-extrabold text-white shadow-xl transition hover:-translate-y-1 hover:bg-white hover:text-[#041B4D]">Work With Us<svg viewBox="0 0 24 24" class="size-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div>
			</div>
		</div>
	</section>
</MainLayout>
