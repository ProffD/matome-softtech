---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/home/CTASection.astro';

const services = [
	{ title: 'Website Development', description: 'Professional, responsive business websites that build trust, explain your services clearly and make it easy for customers to contact you.', tag: 'Design + build' },
	{ title: 'Custom Software', description: 'Purpose-built portals, dashboards and workflow tools designed around your business process instead of forcing your team into generic software.', tag: 'Built around you' },
	{ title: 'Hosting & Domains', description: 'Domain registration, hosting setup and practical support to keep your website and online presence running smoothly.', tag: 'Managed essentials' },
	{ title: 'Business Email', description: 'Custom domain email setup, forwarding and migration support so your business communicates more professionally.', tag: 'Professional setup' },
	{ title: 'Cloud Setup', description: 'Cloud storage, collaboration tools and deployment support selected around your budget, team and operational needs.', tag: 'Flexible infrastructure' },
	{ title: 'Technical Consulting', description: 'Clear technical guidance for architecture, integrations, platform choices and turning ideas into practical implementation plans.', tag: 'Practical direction' },
];

const startingPoints = [
	{ title: 'Need customers to find you?', text: 'Start with a professional website.', path: 'M4 5h16v14H4zM4 9h16M8 14h8M12 11v6' },
	{ title: 'Losing time in spreadsheets?', text: 'Consider custom software or dashboards.', path: 'M5 3h14v18H5zM8 7h8M8 11h3m2 0h3M8 15h3m2 0h3' },
	{ title: 'Need a professional setup?', text: 'Start with domains, email and hosting.', path: 'M3 6h18v12H3zM3 7l9 6 9-6' },
	{ title: 'Building a product idea?', text: 'We can help shape the technical plan.', path: 'M12 3a7 7 0 0 0-4 12.74V20h8v-4.26A7 7 0 0 0 12 3Zm-3 13h6M9 20h6' },
];

const heroServices = [
	{ label: 'Websites', path: 'M3 5h18v14H3zM3 9h18M7 7h.01M10 7h.01M7 13h5M7 16h10' },
	{ label: 'Software', path: 'm8 9-4 3 4 3m8-6 4 3-4 3m-5-8-2 10' },
	{ label: 'Cloud', path: 'M7 18h10a4 4 0 0 0 .5-7.97A6 6 0 0 0 6.2 8.5 4.5 4.5 0 0 0 7 18Z' },
	{ label: 'Support', path: 'M18 14a6 6 0 0 0-12 0M4 14v4h3v-5H4v1Zm16 0v4h-3v-5h3v1ZM8 20h8' },
];
---

<MainLayout title="Services | Matome SoftTech Solutions" description="Website development, custom software, hosting, business email, cloud setup and technical consulting.">
	<PageHero eyebrow="Our services" title="Practical digital services for growing businesses." description="From business websites and custom software to hosting, email and cloud setup, we help you choose and build technology that supports real work." primaryLabel="Discuss Your Project" primaryHref="/contact" secondaryLabel="Explore Our Products" secondaryHref="/labourguard">
		<div class="absolute inset-x-0 top-1/2 mx-auto grid w-[94%] max-w-[500px] -translate-y-1/2 grid-cols-2 gap-3 rotate-[2deg] sm:gap-4">
			{heroServices.map((service, index) => <div class:list={['rounded-3xl border border-white/60 bg-white p-5 shadow-xl sm:p-7', index === 1 || index === 2 ? 'translate-y-5' : '']}><span class="grid size-10 place-items-center rounded-xl bg-sky-100 text-sky-600"><svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={service.path}/></svg></span><p class="mt-5 text-base font-black text-slate-950 sm:text-lg">{service.label}</p><div class="mt-3 h-1.5 w-16 rounded-full bg-sky-500"></div></div>)}
		</div>
	</PageHero>

	<section class="py-20 sm:py-28">
		<div class="section-shell">
			<div class="mx-auto max-w-3xl text-center"><p class="eyebrow text-sky-600">What we do</p><h2 class="mt-4 text-4xl font-black tracking-[-.035em] sm:text-5xl">A practical service stack for modern business.</h2><p class="mt-5 text-lg leading-8 text-slate-600">Start with the service you need today, then grow into better systems as your business becomes more digital.</p></div>
			<div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
				{services.map((service, index) => <article class="group rounded-3xl border border-slate-200 bg-white p-7 transition hover:-translate-y-1 hover:border-sky-200 hover:shadow-xl hover:shadow-sky-100"><div class="flex items-center justify-between"><span class="text-xs font-black tracking-[.16em] text-sky-600">0{index + 1}</span><span class="rounded-full bg-sky-50 px-3 py-1 text-[10px] font-extrabold uppercase tracking-wider text-sky-700">{service.tag}</span></div><h3 class="mt-8 text-2xl font-black text-slate-950">{service.title}</h3><p class="mt-4 leading-7 text-slate-600">{service.description}</p><a href="/contact" class="mt-6 inline-flex items-center gap-2 text-sm font-extrabold text-sky-700">Talk to us <svg viewBox="0 0 24 24" class="size-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></a></article>)}
			</div>
		</div>
	</section>

	<section class="bg-sky-50/70 py-20 sm:py-24">
		<div class="section-shell">
			<div class="mx-auto max-w-3xl text-center"><p class="eyebrow text-sky-600">A practical starting point</p><h2 class="mt-4 text-4xl font-black tracking-[-.035em] text-[#041B4D] sm:text-5xl">Not sure where to start?</h2><p class="mt-5 text-lg leading-8 text-slate-600">Tell us what you are trying to improve — more enquiries, fewer manual processes, better reporting, professional email or a new product idea. We will help you choose the right next step.</p></div>
			<div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">{startingPoints.map((item) => <article class="rounded-3xl border border-sky-100 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-xl hover:shadow-sky-100"><span class="grid size-12 place-items-center rounded-2xl bg-sky-50 text-[#0E5CFF]"><svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.path}/></svg></span><h3 class="mt-6 text-xl font-black leading-snug text-[#041B4D]">{item.title}</h3><p class="mt-3 leading-7 text-slate-600">{item.text}</p></article>)}</div>
		</div>
	</section>

	<section class="bg-gradient-to-br from-[#041B4D] via-[#0B2A6F] to-[#0E5CFF] py-20 text-white sm:py-28">
		<div class="section-shell"><div class="mx-auto max-w-2xl text-center"><p class="eyebrow text-sky-300">How we work</p><h2 class="mt-4 text-4xl font-black tracking-[-.035em]">Clear from first conversation to launch.</h2></div><ol class="mt-12 grid gap-4 md:grid-cols-4">{[['01','Understand','We clarify the business problem, users, goals and constraints.'],['02','Shape','We define the solution, scope, content and technical approach.'],['03','Build','We design, develop, test and refine the solution.'],['04','Support','We help with launch, updates and improvements after delivery.']].map(([number,title,text]) => <li class="rounded-2xl border border-white/15 bg-white/10 p-6"><span class="text-xs font-black text-sky-300">{number}</span><h3 class="mt-6 text-xl font-black">{title}</h3><p class="mt-3 text-sm leading-6 text-blue-100">{text}</p></li>)}</ol></div>
	</section>
	<CTASection />
</MainLayout>
