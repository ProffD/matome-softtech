---
import MainLayout from '../layouts/MainLayout.astro';
import Web3FormsHandler from '../components/Web3FormsHandler.astro';

const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
const redirectUrl = import.meta.env.PROD ? 'https://matomesofttech.co.za/thank-you' : 'http://localhost:4321/thank-you';

const services = [
	{ title: 'Generator Hire', description: 'Small to large generators for events, homes, businesses and temporary backup power needs.', path: 'M4 7h16v11H4zM7 10h4v5H7zM15 10h2m-2 3h2M7 4h10v3M8 21h8M9 18v3m6-3v3' },
	{ title: 'LP Gas Supply', description: 'Refill, exchange and delivery support for homes, businesses and events.', path: 'M9 3h6v3l2 3v11H7V9l2-3V3Zm0 6h6M10 13h4m-2-2v4' },
	{ title: 'Backup Power Support', description: 'Support for backup power planning and load shedding readiness.', path: 'M4 13h16l-2 7H6l-2-7Zm3 0 1-6h8l1 6M12 2v2m7.1 1.9-1.4 1.4M4.9 5.9l1.4 1.4' },
	{ title: 'Repairs & Maintenance', description: 'Keep power equipment in good condition with maintenance and repair support.', path: 'm14 6 4 4M5 19l5-5m7-9a4 4 0 0 0-5 5L4 18l2 2 8-8a4 4 0 0 0 5-5Z' },
];

const useCases = [
	['Weddings and events', 'M8 4a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm8 0a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm-4 5c2 2 4 3 4 6a4 4 0 0 1-8 0c0-3 2-4 4-6Z'],
	['Church services', 'M4 21h16M6 21V10l6-7 6 7v11M9 21v-6h6v6M12 3v-2m-2 2h4'],
	['Funerals and memorials', 'M12 21s7-4.4 7-11a7 7 0 1 0-14 0c0 6.6 7 11 7 11Zm0-14v6m-3-3h6'],
	['Corporate functions', 'M16 20v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M9.5 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm8.5 1a3 3 0 0 0 0-6m3 15v-2a4 4 0 0 0-3-3.87'],
	['Construction sites', 'M3 21h18M6 21V9h12v12M8 9l4-6 4 6M9 14h6M9 18h6'],
	['Home and business backup', 'M3 11 12 3l9 8M5 10v11h14V10M9 21v-6h6v6'],
	['Restaurants and small businesses', 'M4 10h16l-1-5H5l-1 5Zm1 0v10h14V10M8 20v-6h5v6'],
];

const reasons = [
	['Reliable power', 'Dependable equipment for events, homes and business needs.', 'M12 3 4.5 6v5.5c0 4.7 3.2 7.8 7.5 9.5 4.3-1.7 7.5-4.8 7.5-9.5V6L12 3Zm-3 9 2 2 4-4'],
	['Fuel efficient options', 'Options selected around runtime, load size and fuel needs.', 'M8 20h8V4H8zM10 7h4M16 8h2l2 3v6a2 2 0 0 1-4 0'],
	['Quiet operation options', 'Suitable choices for events, churches and sensitive environments.', 'M5 9H2v6h3l5 4V5L5 9Zm10 1 5 5m0-5-5 5'],
	['Professional setup and support', 'Practical delivery, setup and support options.', 'M18 14a6 6 0 0 0-12 0M4 14v4h3v-5H4v1Zm16 0v4h-3v-5h3v1ZM8 20h8'],
	['Local coverage', 'Serving Pretoria and surrounding areas.', 'M12 21s7-6 7-12a7 7 0 1 0-14 0c0 6 7 12 7 12Zm0-9a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z'],
];
---

<MainLayout title="PowerGuard | Generator Hire, LP Gas & Backup Power" description="Generator hire, LP gas supply and backup power support for events, homes and businesses in Pretoria and surrounding areas.">
	<section class="relative isolate overflow-hidden bg-[#020B12] text-white">
		<div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_75%_30%,rgba(245,179,0,.16),transparent_32%),linear-gradient(110deg,#020B12_0%,#041B4D_60%,#020B12_100%)]" aria-hidden="true"></div>
		<div class="absolute inset-0 -z-10 opacity-20" aria-hidden="true"><svg viewBox="0 0 1440 760" class="h-full w-full" preserveAspectRatio="none" fill="none"><circle cx="1280" cy="30" r="340" stroke="#F5B300"/><circle cx="1280" cy="30" r="250" stroke="#F5B300"/><path d="M0 620c300-150 510 70 800-45 230-90 420-70 640-15" stroke="#F5B300" stroke-dasharray="3 15"/></svg></div>

		<div class="section-shell grid items-center gap-12 pb-20 pt-16 lg:min-h-[690px] lg:grid-cols-[.82fr_1.18fr] lg:gap-14 lg:py-20">
			<div class="max-w-xl">
				<p class="text-sm font-black tracking-tight"><span class="text-[#F5B300]">PowerGuard</span> Energy Supply</p>
				<h1 class="mt-6 text-5xl font-black leading-[1.02] tracking-[-.045em] sm:text-6xl lg:text-[4.25rem]">Power you can trust.<br/><span class="text-[#F5B300]">Energy you can rely on.</span></h1>
				<p class="mt-7 max-w-lg text-lg leading-8 text-slate-300">Generator hire, LP gas supply and backup power support for events, homes, businesses, funerals, churches and essential operations.</p>
				<div class="mt-9 flex flex-wrap gap-4">
					<a href="/contact" class="group inline-flex items-center gap-3 rounded-xl bg-[#F5B300] px-7 py-4 text-sm font-black text-[#020B12] shadow-xl shadow-amber-950/30 transition hover:-translate-y-1 hover:bg-yellow-300">Get a Quote<svg viewBox="0 0 24 24" class="size-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
					<a href="#powerguard-services" class="inline-flex items-center gap-3 rounded-xl border border-white/60 bg-white/5 px-7 py-4 text-sm font-extrabold text-white transition hover:border-[#F5B300] hover:text-[#F5B300]">Explore Services<svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14m-6-6 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
				</div>
			</div>

			<div class="relative mx-auto w-full max-w-[650px]" aria-label="powerGuard generator and service overview">
				<div class="relative overflow-hidden rounded-[2rem] border border-[#F5B300]/40 bg-gradient-to-br from-[#182027] to-[#030608] p-5 shadow-[0_35px_90px_rgba(0,0,0,.65)] sm:p-7">
					<div class="flex items-center justify-between"><div class="flex items-center gap-3"><img src="/powerguard-mark.svg" alt="" class="h-12 w-11" aria-hidden="true"/><div><p class="text-lg font-black"><span class="text-[#F5B300]">PowerGuard</span></p><p class="text-[10px] font-bold uppercase tracking-[.18em] text-slate-400">Energy Supply</p></div></div><span class="rounded-full border border-emerald-500/40 bg-emerald-500/10 px-3 py-1.5 text-[9px] font-black uppercase tracking-wider text-emerald-400">Ready</span></div>

					<div class="relative mx-auto mt-10 max-w-[470px] pb-7">
						<div class="absolute left-[18%] right-[18%] -top-6 h-16 rounded-t-[1.5rem] border-[7px] border-b-0 border-slate-500"></div>
						<div class="relative overflow-hidden rounded-[1.5rem] border-4 border-slate-600 bg-[#080B0E] shadow-2xl">
							<div class="h-10 bg-gradient-to-r from-[#D69300] via-[#FFC400] to-[#D69300]"></div>
							<div class="grid min-h-[220px] grid-cols-[1.25fr_.75fr] gap-4 p-5 sm:p-7">
								<div><div class="flex items-center gap-2 border-b border-white/10 pb-4"><img src="/powerguard-mark.svg" alt="" class="h-7 w-6" aria-hidden="true"/><span class="text-xl font-black">powerGuard</span></div><div class="mt-5 grid grid-cols-3 gap-2"><div class="grid aspect-square place-items-center rounded-full border-4 border-slate-600 bg-slate-800"><span class="size-2 rounded-full bg-emerald-400"></span></div><div class="grid aspect-square place-items-center rounded-lg border-2 border-[#F5B300]/70"><div class="size-5 rounded-full border-2 border-[#F5B300]"></div></div><div class="grid aspect-square place-items-center rounded-lg bg-red-600"><span class="text-[8px] font-black">STOP</span></div></div></div>
								<div class="space-y-2">{[0,1,2,3,4,5].map(() => <div class="h-3 rounded-full bg-slate-700"></div>)}<div class="mt-5 flex justify-between"><span class="size-4 rounded-full bg-[#F5B300]"></span><span class="size-4 rounded-full bg-emerald-500"></span><span class="size-4 rounded-full bg-red-500"></span></div></div>
							</div>
						</div>
						<div class="absolute -bottom-1 left-8 size-14 rounded-full border-[9px] border-slate-600 bg-[#050708] shadow-xl sm:size-16"></div><div class="absolute -bottom-1 right-8 size-14 rounded-full border-[9px] border-slate-600 bg-[#050708] shadow-xl sm:size-16"></div>
					</div>

					<div class="mt-5 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-white/10 bg-white/10 sm:grid-cols-4">
						{services.map((service) => <div class="bg-[#0A1118] p-3 text-center"><svg viewBox="0 0 24 24" class="mx-auto size-5 text-[#F5B300]" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={service.path}/></svg><p class="mt-2 text-[9px] font-black text-white">{service.title}</p></div>)}
					</div>
				</div>
			</div>
		</div>
	</section>

	<section id="powerguard-services" class="scroll-mt-24 bg-white py-20 sm:py-28">
		<div class="section-shell">
			<div><p class="eyebrow text-[#D99A00]">What we provide</p><h2 class="mt-3 text-4xl font-black tracking-[-.035em] text-[#041B4D] sm:text-5xl"><span class="text-[#041B4D]">PowerGuard</span> <span class="text-[#D99A00]">services</span></h2><div class="mt-5 h-1 w-14 bg-[#F5B300]"></div></div>
			<div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
				{services.map((service, index) => <article class="group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-[0_16px_40px_rgba(15,23,42,.08)] transition hover:-translate-y-1 hover:shadow-xl">
					<div class:list={['relative grid h-44 place-items-center overflow-hidden', index === 1 ? 'bg-gradient-to-br from-blue-950 via-blue-700 to-blue-400' : index === 2 ? 'bg-gradient-to-br from-amber-200 via-amber-500 to-[#041B4D]' : 'bg-gradient-to-br from-[#05090D] via-[#182027] to-[#041B4D]']}><div class="absolute inset-0 opacity-20"><svg viewBox="0 0 300 180" class="h-full w-full" fill="none"><circle cx="250" cy="20" r="100" stroke="white"/><path d="M0 155c90-70 170 30 300-40" stroke="white"/></svg></div><span class="relative grid size-20 place-items-center rounded-full border border-white/30 bg-black/25 text-[#F5B300] backdrop-blur-sm"><svg viewBox="0 0 24 24" class="size-10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={service.path}/></svg></span></div>
					<div class="relative p-6"><span class="absolute -top-7 grid size-14 place-items-center rounded-full border-4 border-white bg-[#F5B300] text-[#020B12] shadow-lg"><svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={service.path}/></svg></span><h3 class="mt-5 text-xl font-black text-[#041B4D]">{service.title}</h3><p class="mt-3 text-sm leading-7 text-slate-600">{service.description}</p></div>
				</article>)}
			</div>
		</div>
	</section>

	<section class="bg-[#020B12] py-20 text-white sm:py-24">
		<div class="section-shell"><div><p class="eyebrow text-[#F5B300]">Perfect for</p><h2 class="mt-3 text-4xl font-black tracking-[-.035em]">Powering <span class="text-[#F5B300]">what matters</span></h2><div class="mt-5 h-1 w-14 bg-[#F5B300]"></div></div><div class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-4 xl:grid-cols-7">{useCases.map(([label, path]) => <article class="bg-[#020B12] p-6 text-center transition hover:bg-[#0A1720]"><svg viewBox="0 0 24 24" class="mx-auto size-10 text-[#F5B300]" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={path}/></svg><h3 class="mt-5 text-sm font-black leading-5">{label}</h3></article>)}</div></div>
	</section>

	<section class="bg-white py-20 sm:py-24">
		<div class="section-shell"><div><p class="eyebrow text-[#D99A00]">Why powerGuard</p><h2 class="mt-3 text-4xl font-black tracking-[-.035em] text-[#041B4D]">Why choose <span class="text-[#D99A00]">powerGuard?</span></h2><div class="mt-5 h-1 w-14 bg-[#F5B300]"></div></div><div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">{reasons.map(([title, text, path]) => <article class="rounded-2xl border border-amber-100 bg-amber-50/30 p-6"><svg viewBox="0 0 24 24" class="size-11 text-[#D99A00]" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={path}/></svg><h3 class="mt-5 text-base font-black leading-5 text-[#041B4D]">{title}</h3><p class="mt-3 text-sm leading-6 text-slate-600">{text}</p></article>)}</div></div>
	</section>

	<section class="pb-10 sm:pb-14">
		<div class="section-shell">
			<div class="grid gap-10 overflow-hidden rounded-3xl bg-gradient-to-br from-[#020B12] to-[#0A1720] p-6 text-white shadow-2xl sm:p-10 lg:grid-cols-[.78fr_1.22fr] lg:p-12">
				<div><p class="eyebrow text-[#F5B300]">Request a quote</p><h2 class="mt-4 text-4xl font-black leading-tight tracking-[-.035em]">Need help choosing <span class="text-[#F5B300]">the right power solution?</span></h2><p class="mt-5 leading-7 text-slate-300">Tell us what you need to power, where you are, how long you need backup power and whether you need delivery or setup. We will recommend the right option.</p><div class="mt-8 rounded-2xl border border-[#F5B300]/40 bg-[#F5B300]/5 p-5"><div class="flex gap-3"><svg viewBox="0 0 24 24" class="mt-0.5 size-5 shrink-0 text-[#F5B300]" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.63a2 2 0 0 1-.45 2.11L8 9.73a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.85.3 1.73.5 2.63.62A2 2 0 0 1 22 16.92Z" stroke-linecap="round" stroke-linejoin="round"/></svg><div><p class="text-sm font-black">Tell us what you need</p><p class="mt-1 text-xs leading-5 text-slate-400">We will use the details to recommend a suitable option and quote.</p></div></div></div></div>
				<form action="https://api.web3forms.com/submit" method="POST" class="grid gap-3 sm:grid-cols-2" data-static-form data-turnstile-compatible>
					<input type="hidden" name="access_key" value={web3formsAccessKey} />
					<input type="hidden" name="subject" value="New powerGuard quote request" />
					<input type="hidden" name="from_name" value="Matome SoftTech website" />
					<input type="hidden" name="source" value="PowerGuard Quote Request" />
					<input type="hidden" name="product" value="powerGuard" />
					<input type="hidden" name="redirect" value={redirectUrl} />
					<input type="checkbox" name="botcheck" class="hidden" style="display:none;" tabindex="-1" autocomplete="off" />
					<label class="sr-only" for="quote-name">Name</label><input id="quote-name" name="name" required placeholder="Name" class="rounded-xl border border-white/10 bg-white/10 px-4 py-3.5 text-sm text-white outline-none placeholder:text-slate-400 focus:border-[#F5B300]" />
					<label class="sr-only" for="quote-phone">Phone number</label><input id="quote-phone" name="phone" type="tel" required placeholder="Phone number" class="rounded-xl border border-white/10 bg-white/10 px-4 py-3.5 text-sm text-white outline-none placeholder:text-slate-400 focus:border-[#F5B300]" />
					<label class="sr-only" for="quote-email">Email</label><input id="quote-email" name="email" type="email" required placeholder="Email" class="rounded-xl border border-white/10 bg-white/10 px-4 py-3.5 text-sm text-white outline-none placeholder:text-slate-400 focus:border-[#F5B300]" />
					<label class="sr-only" for="quote-location">Location</label><input id="quote-location" name="location" required placeholder="Location" class="rounded-xl border border-white/10 bg-white/10 px-4 py-3.5 text-sm text-white outline-none placeholder:text-slate-400 focus:border-[#F5B300]" />
					<label class="sr-only" for="quote-use">Use case</label><select id="quote-use" name="use-case" required class="rounded-xl border border-white/10 bg-[#172128] px-4 py-3.5 text-sm text-slate-300 outline-none focus:border-[#F5B300]"><option value="" disabled selected>Use case</option><option>Event</option><option>Home backup</option><option>Business backup</option><option>Construction</option><option>LP gas supply</option><option>Repairs or maintenance</option></select>
					<label class="sr-only" for="quote-date">Date needed</label><input id="quote-date" name="date" type="date" class="rounded-xl border border-white/10 bg-[#172128] px-4 py-3.5 text-sm text-slate-300 outline-none focus:border-[#F5B300]" />
					<label class="sr-only" for="quote-power">What needs to be powered</label><input id="quote-power" name="power-needs" required placeholder="What needs to be powered" class="rounded-xl border border-white/10 bg-white/10 px-4 py-3.5 text-sm text-white outline-none placeholder:text-slate-400 focus:border-[#F5B300] sm:col-span-2" />
					<label class="sr-only" for="quote-duration">Duration</label><input id="quote-duration" name="duration" placeholder="Duration (e.g. 1 day, 3 days)" class="rounded-xl border border-white/10 bg-white/10 px-4 py-3.5 text-sm text-white outline-none placeholder:text-slate-400 focus:border-[#F5B300]" />
					<label class="sr-only" for="quote-message">Message</label><textarea id="quote-message" name="message" rows="4" required placeholder="Message" class="rounded-xl border border-white/10 bg-white/10 px-4 py-3.5 text-sm text-white outline-none placeholder:text-slate-400 focus:border-[#F5B300] sm:col-span-2"></textarea>
					<p class="hidden text-sm font-semibold text-red-300 sm:col-span-2" role="alert" aria-live="polite" data-form-status></p>
					<button type="submit" data-submit-button class="group inline-flex items-center justify-center gap-3 rounded-xl bg-[#F5B300] px-7 py-4 text-sm font-black text-[#020B12] transition hover:bg-yellow-300 disabled:cursor-not-allowed disabled:opacity-60 sm:col-span-2"><span data-submit-label data-idle-label="Request a Quote">Request a Quote</span><svg viewBox="0 0 24 24" class="size-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
				</form>
			</div>
		</div>
	</section>

	<section class="pb-10 sm:pb-14">
		<div class="section-shell"><div class="grid items-center gap-6 rounded-3xl border border-amber-100 bg-gradient-to-r from-amber-50 to-white p-6 shadow-sm sm:p-8 lg:grid-cols-[auto_1fr_1.4fr]"><span class="grid size-16 place-items-center rounded-full bg-[#020B12] text-[#F5B300]"><svg viewBox="0 0 24 24" class="size-8" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 13 11 22 2 13V3h10l8 10ZM7 8h.01" stroke-linecap="round" stroke-linejoin="round"/></svg></span><h2 class="text-3xl font-black tracking-[-.03em] text-[#041B4D]">Pricing <span class="text-[#D99A00]">made simple</span></h2><div class="text-sm leading-7 text-slate-600"><p>Pricing depends on generator size, hire duration, delivery distance, fuel requirements and setup needs.</p><p class="mt-2 font-semibold text-[#041B4D]">Request a quote and we will recommend the right power solution for your needs.</p></div></div></div>
	</section>

	<section class="relative isolate overflow-hidden bg-[#020B12] py-14 text-white sm:py-16">
		<div class="absolute inset-0 -z-10 opacity-15" aria-hidden="true"><svg viewBox="0 0 1440 260" class="h-full w-full" preserveAspectRatio="none" fill="none"><path d="M0 210c300-140 500 80 780-35 250-105 450-60 660-25" stroke="#F5B300" stroke-dasharray="3 14"/></svg></div>
		<div class="section-shell grid items-center gap-8 lg:grid-cols-[1fr_auto]"><div class="flex flex-col gap-6 sm:flex-row sm:items-center"><span class="grid size-20 shrink-0 place-items-center rounded-2xl border border-[#F5B300]/50 bg-[#F5B300]/10"><img src="/powerguard-mark.svg" alt="" class="h-16 w-14" aria-hidden="true"/></span><div><h2 class="text-3xl font-black tracking-[-.03em] sm:text-4xl">Book <span class="text-[#F5B300]">power</span> for your next event or backup need.</h2><p class="mt-3 text-slate-300">We are ready to help keep you powered when you need it.</p></div></div><a href="/contact" class="group inline-flex items-center justify-center gap-3 rounded-xl bg-[#F5B300] px-9 py-4 text-sm font-black text-[#020B12] transition hover:-translate-y-1 hover:bg-yellow-300">Get a Quote<svg viewBox="0 0 24 24" class="size-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></a></div>
	</section>
	<Web3FormsHandler />
</MainLayout>
