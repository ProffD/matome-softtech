---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Thank You | Matome SoftTech Solutions" description="Thank you for contacting Matome SoftTech Solutions.">
	<section class="relative isolate overflow-hidden bg-gradient-to-br from-[#041B4D] via-[#0E5CFF] to-[#19B5FF] py-24 text-white sm:py-32">
		<div class="section-shell">
			<div class="mx-auto max-w-2xl rounded-3xl border border-white/30 bg-white/10 p-8 text-center shadow-2xl backdrop-blur-sm sm:p-12">
				<span class="mx-auto grid size-16 place-items-center rounded-full bg-white text-[#0E5CFF]"><svg viewBox="0 0 24 24" class="size-8" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
				<p class="eyebrow mt-7 text-cyan-200">Message received</p>
				<h1 class="mt-4 text-4xl font-black tracking-[-.035em] sm:text-5xl">Thank you for getting in touch.</h1>
				<p class="mt-5 text-lg leading-8 text-blue-50">Your enquiry has been submitted. The Matome SoftTech Solutions team will review the details and respond as soon as possible.</p>
				<a href="/" class="mt-8 inline-flex items-center gap-3 rounded-full bg-[#041B4D] px-7 py-4 text-sm font-extrabold text-white transition hover:-translate-y-1 hover:bg-white hover:text-[#041B4D]">Return Home<svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
			</div>
		</div>
	</section>
</MainLayout>
