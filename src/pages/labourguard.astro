---
import MainLayout from '../layouts/MainLayout.astro';
import Web3FormsHandler from '../components/Web3FormsHandler.astro';

const web3formsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
const redirectUrl = import.meta.env.PROD ? 'https://matomesofttech.co.za/thank-you' : 'http://localhost:4321/thank-you';

const sidebarItems = [
	['Overview', 'M4 5h6v6H4zM14 5h6v6h-6zM4 15h6v4H4zM14 15h6v4h-6z'],
	['Employees', 'M16 20v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M9.5 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm8.5 1a3 3 0 0 0 0-6m3 15v-2a4 4 0 0 0-3-3.87'],
	['Documents', 'M6 3h8l4 4v14H6zM14 3v5h5M9 13h6M9 17h6'],
	['Compliance', 'M12 3 4.5 6v5.5c0 4.7 3.2 7.8 7.5 9.5 4.3-1.7 7.5-4.8 7.5-9.5V6L12 3Zm-3 9 2 2 4-4'],
	['Risks', 'M12 3 2.8 20h18.4L12 3Zm0 6v5m0 3h.01'],
	['Reports', 'M5 3h14v18H5zM9 16v-3m3 3V8m3 8v-5'],
	['Sites', 'M4 21V7l8-4 8 4v14M9 21v-5h6v5M8 9h.01M12 9h.01M16 9h.01M8 13h.01M16 13h.01'],
	['Settings', 'M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm0-12v2m0 13v2m8.5-8.5h-2m-13 0h-2m14.5-6-1.4 1.4M7.4 16.6 6 18m12 0-1.4-1.4M7.4 7.4 6 6'],
];

const metrics = [
	{ label: 'Employees', value: '256', note: 'Total', color: 'text-[#0E5CFF]', bg: 'bg-blue-50', path: 'M16 20v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M9.5 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z' },
	{ label: 'Active Sites', value: '18', note: 'Total', color: 'text-emerald-600', bg: 'bg-emerald-50', path: 'M4 21V7l8-4 8 4v14M9 21v-5h6v5M8 9h.01M12 9h.01M16 9h.01' },
	{ label: 'Expiring Documents', value: '7', note: 'Next 30 days', color: 'text-orange-500', bg: 'bg-orange-50', path: 'M5 5h14v16H5zM8 3v4m8-4v4M5 10h14M9 14h2m2 0h2m-6 3h2' },
	{ label: 'Open Risks', value: '12', note: 'Action required', color: 'text-red-600', bg: 'bg-red-50', path: 'M12 3 4.5 6v5.5c0 4.7 3.2 7.8 7.5 9.5 4.3-1.7 7.5-4.8 7.5-9.5V6L12 3Zm0 5v5m0 3h.01' },
];

const expiryItems = [['Work Permits', '3'], ['ID Documents', '2'], ['Medical Certificates', '1'], ['Certificates', '1']];
const risks = [['Expired work permit', 'High', 'bg-red-50 text-red-600'], ['Missing medical certificate', 'Medium', 'bg-orange-50 text-orange-600'], ['Work permit expiring soon', 'Low', 'bg-emerald-50 text-emerald-600']];

const trustItems = [
	{ title: 'Built for South African businesses', text: 'Stay compliant, reduce risk and stay inspection-ready.', path: 'M12 3 4.5 6v5.5c0 4.7 3.2 7.8 7.5 9.5 4.3-1.7 7.5-4.8 7.5-9.5V6L12 3Zm-3 9 2 2 4-4' },
	{ title: 'Trusted by growing teams', text: 'Simple workforce compliance for teams with many workers, documents and sites.', path: 'M16 20v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M9.5 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm8.5 1a3 3 0 0 0 0-6m3 15v-2a4 4 0 0 0-3-3.87' },
	{ title: 'Secure. Reliable. Always accessible.', text: 'Keep workforce records protected, organised and available when needed.', path: 'M7 10V8a5 5 0 0 1 10 0v2m-12 0h14v11H5zM12 14v3' },
];

const features = [
	{ title: 'Employee document management', description: 'Store employee documents, contracts, work permits, certificates and supporting records in one organised workspace.', path: 'M3 7h7l2 2h9v11H3zM3 7V5h7l2 2' },
	{ title: 'Expiry tracking and reminders', description: 'Track documents expiring soon and take action before missing paperwork becomes a compliance risk.', path: 'M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4' },
	{ title: 'Workforce compliance visibility', description: 'Monitor missing documents, expired records, open risks and site-level compliance from a live dashboard.', path: 'M12 3 4.5 6v5.5c0 4.7 3.2 7.8 7.5 9.5 4.3-1.7 7.5-4.8 7.5-9.5V6L12 3Zm-3 9 2 2 4-4' },
	{ title: 'Audit-ready reporting', description: 'Generate practical reports to help managers prepare for inspections, reviews and internal compliance checks.', path: 'M6 3h9l4 4v14H6zM15 3v5h5M9 16l2-2 2 1 3-4' },
];

const audiences = [
	['Construction and contractors', 'M3 21h18M6 21V8h6v13M12 21V4h6v17M8 11h2m-2 4h2m4-7h2m-2 4h2m-2 4h2'],
	['Restaurants and hospitality', 'M5 3v6a3 3 0 0 0 6 0V3M8 3v18M17 3v18M17 3c3 2 3 7 0 9h-3'],
	['Manufacturing and factories', 'M3 21V10l6 3V9l6 4V6h6v15zM7 17h.01M11 17h.01M15 17h.01M19 17h.01'],
	['Security companies', 'M12 3 4.5 6v5.5c0 4.7 3.2 7.8 7.5 9.5 4.3-1.7 7.5-4.8 7.5-9.5V6L12 3Z'],
	['Cleaning and facilities teams', 'm5 20 8-13 5 3-8 12M14 5l2-3 3 2-2 3'],
	['Logistics and warehousing', 'M3 6h11v10H3zM14 10h4l3 3v3h-7zM7 20a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm10 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z'],
];

const workflow = [
	['Add employees and site assignments', 'M16 20v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2M9.5 10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z'],
	['Upload work permits, contracts and certificates', 'M6 3h9l4 4v14H6zM15 3v5h5M12 17V10m-3 3 3-3 3 3'],
	['Track expiries, missing documents and risks', 'M12 3 4.5 6v5.5c0 4.7 3.2 7.8 7.5 9.5 4.3-1.7 7.5-4.8 7.5-9.5V6L12 3Zm0 5v5m0 3h.01'],
	['Generate compliance reports when needed', 'M5 21V10h3v11m3 0V5h3v16m3 0v-8h3v8M3 21h19'],
];
---

<MainLayout title="LabourGuard | Workforce Compliance Software" description="Manage employee records, work permits, document expiries, compliance risks and inspection-ready reports with labourGuard.">
	<section class="relative isolate overflow-hidden bg-gradient-to-br from-[#073E9F] via-[#0E5CFF] to-[#19B5FF] text-white">
		<div class="absolute inset-0 -z-10 opacity-20" aria-hidden="true"><svg viewBox="0 0 1440 760" class="h-full w-full" preserveAspectRatio="none" fill="none"><circle cx="1310" cy="20" r="330" stroke="white"/><circle cx="1310" cy="20" r="240" stroke="white"/><path d="M0 590c260-160 470 90 760-60 240-125 460-80 680 10" stroke="white" opacity=".45"/><path d="M0 650h540M0 690h360" stroke="white" stroke-dasharray="2 16" opacity=".4"/></svg></div>

		<div class="section-shell grid items-center gap-12 pb-32 pt-14 lg:min-h-[650px] lg:grid-cols-[.72fr_1.28fr] lg:gap-10 lg:pb-28 lg:pt-16">
			<div class="max-w-xl">
				<div class="inline-flex items-center gap-2 rounded-full border border-white/60 bg-white/10 px-4 py-2 text-sm font-extrabold backdrop-blur-sm"><span class="size-2 rounded-full bg-cyan-300"></span>labourGuard</div>
				<h1 class="mt-7 text-5xl font-black leading-[1.02] tracking-[-.045em] sm:text-6xl lg:text-[4.15rem]">Stay ready for every labour inspection.</h1>
				<p class="mt-7 max-w-lg text-base font-medium leading-7 text-blue-50 sm:text-lg">Manage employee records, work permits, contracts, certifications, expiry dates and compliance risks from one workforce compliance platform.</p>
				<div class="mt-9 flex flex-wrap gap-4">
					<a href="https://labourguardapp.co.za/" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-3 rounded-full bg-[#041B4D] px-4 py-4 text-sm font-extrabold text-white shadow-xl transition hover:-translate-y-1 hover:bg-white hover:text-[#041B4D]">Visit LabourGuard<svg viewBox="0 0 24 24" class="size-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
					<a href="/powerguard" class="group inline-flex items-center gap-3 rounded-full border border-white/70 bg-white/10 px-7 py-4 text-sm font-extrabold text-white backdrop-blur-sm transition hover:bg-white hover:text-[#041B4D]">View PowerGuard<svg viewBox="0 0 24 24" class="size-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
				</div>
			</div>

			<div class="overflow-hidden rounded-[1.6rem] border-4 border-white/25 bg-white text-slate-950 shadow-[0_35px_90px_rgba(4,27,77,.38)]">
				<div class="flex h-14 items-center justify-between border-b border-slate-200 px-4 sm:px-5">
					<div class="flex items-center gap-2"><span class="grid size-8 place-items-center rounded-lg bg-[#0E5CFF] text-[10px] font-black text-white">LG</span><span class="text-sm font-black">labourGuard</span></div>
					<div class="flex items-center gap-3 text-slate-400"><svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4"/></svg><span class="grid size-7 place-items-center rounded-full bg-blue-50 text-[8px] font-black text-blue-700">TM</span></div>
				</div>
				<div class="grid grid-cols-[4.8rem_1fr] sm:grid-cols-[7.6rem_1fr]">
					<aside class="bg-[#052C75] p-2.5 text-white sm:p-3">
						<nav class="space-y-1" aria-label="Dashboard navigation">{sidebarItems.map(([label, path], index) => <div class:list={['flex items-center gap-2 rounded-lg px-2 py-2 text-[7px] font-semibold sm:text-[9px]', index === 0 ? 'bg-[#0E5CFF]' : 'text-blue-100']}><svg viewBox="0 0 24 24" class="size-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={path}/></svg><span class="truncate">{label}</span></div>)}</nav>
					</aside>
					<div class="bg-slate-50 p-3 sm:p-4">
						<div class="flex items-center justify-between gap-3"><h2 class="text-xs font-black sm:text-sm">Workforce Compliance Overview</h2><span class="hidden rounded-lg border border-slate-200 bg-white px-3 py-2 text-[8px] font-bold text-slate-500 sm:block">All Sites</span></div>
						<div class="mt-3 grid grid-cols-2 gap-2 xl:grid-cols-4">{metrics.map((metric) => <div class="rounded-xl border border-slate-100 bg-white p-2.5 shadow-sm sm:p-3"><div class="flex items-start justify-between gap-1"><div><p class="text-[6px] font-bold text-slate-500 sm:text-[8px]">{metric.label}</p><p class:list={['mt-2 text-lg font-black sm:text-xl', metric.color]}>{metric.value}</p><p class="mt-1 text-[6px] text-slate-400">{metric.note}</p></div><span class:list={['mt-3 grid size-7 shrink-0 place-items-center rounded-full', metric.bg, metric.color]}><svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={metric.path}/></svg></span></div></div>)}</div>
						<div class="mt-3 grid gap-2 xl:grid-cols-3">
							<div class="rounded-xl border border-slate-100 bg-white p-3 shadow-sm"><p class="text-[8px] font-black">Compliance Score</p><div class="mx-auto mt-3 grid size-24 place-items-center rounded-full bg-[conic-gradient(#0E5CFF_0_35%,#19B5FF_35%_65%,#10B981_65%_98%,#E2E8F0_98%)] p-2"><div class="grid size-full place-items-center rounded-full bg-white text-center"><div><p class="text-xl font-black">98%</p><p class="text-[7px] font-bold text-emerald-600">Very Good</p></div></div></div></div>
							<div class="rounded-xl border border-slate-100 bg-white p-3 shadow-sm"><p class="text-[8px] font-black">Document Expiry <span class="font-medium text-slate-400">(Next 30 Days)</span></p><div class="mt-3 space-y-2.5">{expiryItems.map(([label, value], index) => <div class="flex items-center justify-between gap-2"><span class="truncate text-[7px] font-semibold text-slate-600 sm:text-[8px]">{label}</span><span class:list={['grid size-5 shrink-0 place-items-center rounded-full text-[7px] font-black', index < 2 ? 'bg-orange-50 text-orange-600' : 'bg-emerald-50 text-emerald-600']}>{value}</span></div>)}</div></div>
							<div class="rounded-xl border border-slate-100 bg-white p-3 shadow-sm"><div class="flex justify-between"><p class="text-[8px] font-black">Recent Risks</p><span class="text-[7px] font-bold text-[#0E5CFF]">View all</span></div><div class="mt-3 space-y-3">{risks.map(([risk, level, style]) => <div class="flex items-start justify-between gap-2"><div><p class="text-[7px] font-bold text-slate-700 sm:text-[8px]">{risk}</p><p class="mt-0.5 text-[6px] text-slate-400">Action required</p></div><span class:list={['rounded-full px-2 py-1 text-[6px] font-bold', style]}>{level}</span></div>)}</div></div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="absolute inset-x-0 bottom-0 h-20 text-white" aria-hidden="true"><svg viewBox="0 0 1440 100" class="h-full w-full" preserveAspectRatio="none" fill="currentColor"><path d="M0 55c250-70 480 35 760 5 260-28 470-18 680 15v25H0Z"/></svg></div>
	</section>

	<section class="relative z-10 -mt-5 pb-6">
		<div class="section-shell grid overflow-hidden rounded-2xl border border-blue-100 bg-white shadow-xl shadow-blue-100/50 md:grid-cols-3 md:divide-x md:divide-blue-100">
			{trustItems.map((item) => <div class="flex gap-4 border-b border-blue-100 p-5 last:border-0 md:border-b-0 sm:p-6"><span class="grid size-11 shrink-0 place-items-center rounded-full bg-blue-50 text-[#0E5CFF]"><svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.path}/></svg></span><div><h2 class="text-sm font-black text-[#041B4D]">{item.title}</h2><p class="mt-1 text-xs leading-5 text-slate-500">{item.text}</p></div></div>)}
		</div>
	</section>

	<section class="py-16 sm:py-24">
		<div class="section-shell">
			<h2 class="mx-auto max-w-3xl text-center text-3xl font-black tracking-[-.03em] text-[#041B4D] sm:text-4xl">Everything you need to manage workforce compliance</h2>
			<div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">{features.map((feature) => <article class="group rounded-3xl border border-slate-200 bg-white p-6 shadow-[0_14px_35px_rgba(15,23,42,.08)] transition hover:-translate-y-1 hover:border-blue-200 hover:shadow-blue-100"><span class="grid size-12 place-items-center rounded-2xl bg-blue-50 text-[#0E5CFF]"><svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={feature.path}/></svg></span><h3 class="mt-6 text-xl font-black leading-snug text-[#041B4D]">{feature.title}</h3><p class="mt-4 text-sm leading-7 text-slate-600">{feature.description}</p><div class="mt-5 h-0.5 w-10 bg-[#0E5CFF]"></div></article>)}</div>
		</div>
	</section>

	<section class="bg-gradient-to-b from-white to-blue-50/60 py-16 sm:py-20">
		<div class="section-shell">
			<h2 class="mx-auto max-w-5xl text-center text-3xl font-black tracking-[-.03em] text-[#041B4D] sm:text-4xl">Built for any business that manages workers, documents and compliance risk</h2>
			<p class="mx-auto mt-4 max-w-3xl text-center leading-7 text-slate-600">labourGuard is useful for any organisation that needs to keep employee records, work permits, contracts, certificates and compliance reports organised and inspection-ready.</p>
			<div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">{audiences.map(([label, path]) => <article class="rounded-2xl bg-gradient-to-br from-blue-50 to-sky-100/70 p-6 text-center transition hover:-translate-y-1 hover:shadow-lg"><svg viewBox="0 0 24 24" class="mx-auto size-11 text-[#0E5CFF]" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={path}/></svg><h3 class="mt-5 text-sm font-black leading-5 text-[#041B4D]">{label}</h3></article>)}</div>
			<p class="mx-auto mt-7 max-w-3xl text-center text-sm font-semibold leading-6 text-slate-500">These are examples. labourGuard can support any business that needs better workforce compliance visibility.</p>
		</div>
	</section>

	<section class="py-20 sm:py-24">
		<div class="section-shell">
			<div class="mx-auto max-w-3xl text-center"><h2 class="text-3xl font-black tracking-[-.03em] text-[#041B4D] sm:text-4xl">From employee records to inspection-ready reports</h2><p class="mt-4 leading-7 text-slate-600">Capture workforce information once, keep documents current, track risks early and give managers the visibility they need before inspectors arrive.</p></div>
			<ol class="relative mt-14 grid gap-5 lg:grid-cols-4 lg:gap-8 before:absolute before:left-[12.5%] before:right-[12.5%] before:top-14 before:hidden before:border-t before:border-dashed before:border-blue-300 lg:before:block">{workflow.map(([label, path], index) => <li class="relative flex items-center gap-5 rounded-2xl border border-blue-100 bg-white p-5 shadow-sm lg:block lg:border-0 lg:bg-transparent lg:p-0 lg:text-center lg:shadow-none"><span class="absolute left-3 top-3 z-20 grid size-8 place-items-center rounded-full bg-[#0E5CFF] text-xs font-black text-white shadow-sm ring-4 ring-white lg:-top-2 lg:left-[calc(50%_-_3.5rem)]">{index + 1}</span><span class="relative z-10 grid size-20 shrink-0 place-items-center rounded-full bg-blue-50 text-[#0E5CFF] lg:mx-auto lg:size-28"><svg viewBox="0 0 24 24" class="size-9 lg:size-11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={path}/></svg></span><h3 class="max-w-[13rem] text-sm font-black leading-5 text-[#041B4D] lg:mx-auto lg:mt-5">{label}</h3></li>)}</ol>
		</div>
	</section>

	<section class="pb-20 sm:pb-28">
		<div class="section-shell">
			<div class="relative isolate overflow-hidden rounded-3xl bg-gradient-to-r from-[#073E9F] via-[#0E5CFF] to-[#19B5FF] px-6 py-12 text-white shadow-2xl shadow-blue-200 sm:px-10 lg:px-14 lg:py-14">
				<div class="absolute inset-0 -z-10 opacity-20" aria-hidden="true"><svg viewBox="0 0 1200 280" class="h-full w-full" preserveAspectRatio="none" fill="none"><circle cx="1100" cy="20" r="180" stroke="white"/><path d="M0 230c300-150 500 80 770-40 170-75 300-75 430-40" stroke="white"/></svg></div>
				<div class="grid items-center gap-10 lg:grid-cols-[.82fr_1.18fr]">
					<div class="flex flex-col gap-6 sm:flex-row sm:items-center"><span class="grid size-20 shrink-0 place-items-center rounded-full border border-white/50 bg-white/10"><svg viewBox="0 0 24 24" class="size-10" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 5h14v16H5zM8 3v4m8-4v4M5 10h14M8 14h3m2 0h3m-8 4h3m2 0h3" stroke-linecap="round"/></svg></span><div><h2 class="text-3xl font-black tracking-[-.03em] sm:text-4xl">Make workforce compliance easier to manage.</h2><p class="mt-3 max-w-2xl leading-7 text-blue-50">Book a demo and see how labourGuard can help your team stay organised, prepared and inspection-ready.</p></div></div>
					<form action="https://api.web3forms.com/submit" method="POST" class="grid gap-3 sm:grid-cols-2" data-static-form data-turnstile-compatible>
						<input type="hidden" name="access_key" value={web3formsAccessKey} />
						<input type="hidden" name="subject" value="New labourGuard demo request" />
						<input type="hidden" name="from_name" value="Matome SoftTech website" />
						<input type="hidden" name="source" value="LabourGuard Demo Request" />
						<input type="hidden" name="product" value="labourGuard" />
						<input type="hidden" name="redirect" value={redirectUrl} />
						<input type="checkbox" name="botcheck" class="hidden" style="display:none;" tabindex="-1" autocomplete="off" />
						<label class="sr-only" for="demo-name">Name</label><input id="demo-name" name="name" required placeholder="Name" class="rounded-xl border border-white/20 bg-white/10 px-4 py-3.5 text-sm text-white outline-none placeholder:text-blue-100 focus:border-white" />
						<label class="sr-only" for="demo-email">Email</label><input id="demo-email" name="email" type="email" required placeholder="Email" class="rounded-xl border border-white/20 bg-white/10 px-4 py-3.5 text-sm text-white outline-none placeholder:text-blue-100 focus:border-white" />
						<label class="sr-only" for="demo-phone">Phone</label><input id="demo-phone" name="phone" type="tel" required placeholder="Phone number" class="rounded-xl border border-white/20 bg-white/10 px-4 py-3.5 text-sm text-white outline-none placeholder:text-blue-100 focus:border-white sm:col-span-2" />
						<label class="sr-only" for="demo-message">Message</label><textarea id="demo-message" name="message" rows="3" required placeholder="Tell us about your workforce compliance needs" class="rounded-xl border border-white/20 bg-white/10 px-4 py-3.5 text-sm text-white outline-none placeholder:text-blue-100 focus:border-white sm:col-span-2"></textarea>
						<p class="hidden text-sm font-semibold text-red-100 sm:col-span-2" role="alert" aria-live="polite" data-form-status></p>
						<button type="submit" data-submit-button class="group inline-flex items-center justify-center gap-3 rounded-full bg-[#041B4D] px-8 py-4 text-sm font-extrabold text-white shadow-xl transition hover:bg-white hover:text-[#041B4D] disabled:cursor-not-allowed disabled:opacity-60 sm:col-span-2"><span data-submit-label data-idle-label="Request a Demo">Request a Demo</span><svg viewBox="0 0 24 24" class="size-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
					</form>
				</div>
			</div>
		</div>
	</section>
	<Web3FormsHandler />
</MainLayout>
