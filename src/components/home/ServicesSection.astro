---
const services = [
	{ title: 'Business Websites', description: 'Fast, polished websites designed to turn attention into real enquiries.', path: 'M4 6h16v12H4zM4 9h16M7 7.5h.01M10 7.5h.01' },
	{ title: 'Custom Software', description: 'Practical systems shaped around the way your team actually works.', path: 'm8 9-4 3 4 3m8-6 4 3-4 3m-5-8-2 10' },
	{ title: 'Hosting & Domains', description: 'Dependable hosting and domain management without the admin headache.', path: 'M5 5h14v5H5zM5 14h14v5H5zM8 7.5h.01M8 16.5h.01M16 7.5h1M16 16.5h1' },
	{ title: 'Business Email', description: 'Professional email that keeps communication credible and organised.', path: 'M3 6h18v12H3zM3 7l9 6 9-6' },
	{ title: 'Cloud Setup', description: 'Cloud storage, collaboration tools and deployment support selected around your budget, team and operational needs.', path: 'M7 18h10a4 4 0 0 0 .5-7.97A6 6 0 0 0 6.2 8.5 4.5 4.5 0 0 0 7 18Z' },
	{ title: 'Technical Consulting', description: 'Clear technical guidance for better systems, decisions and growth.', path: 'M12 3a7 7 0 0 0-4 12.74V20h8v-4.26A7 7 0 0 0 12 3Zm-3 13h6M9 20h6' },
];
---

<section id="services" class="bg-[#041B4D] py-20 text-white sm:py-28">
	<div class="section-shell">
		<div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
			<div><p class="eyebrow text-sky-400">Services that fit</p><h2 class="mt-4 text-4xl font-black tracking-[-0.035em] sm:text-5xl">A capable tech team, without the complexity.</h2></div>
			<p class="max-w-2xl text-lg leading-8 text-slate-400 lg:justify-self-end">From your public website to the systems behind the scenes, we help you choose, build and run technology that earns its place in the business.</p>
		</div>
		<div class="mt-14 grid gap-px overflow-hidden rounded-[2rem] border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-3">
			{services.map((service) => (
				<a href="/services" class="group bg-[#041B4D] p-7 transition hover:bg-[#08275D] sm:p-8">
					<span class="grid size-12 place-items-center rounded-2xl bg-sky-500/10 text-sky-400 transition group-hover:bg-sky-500 group-hover:text-white"><svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={service.path}/></svg></span>
					<h3 class="mt-6 text-xl font-extrabold">{service.title}</h3><p class="mt-3 text-sm leading-6 text-slate-400">{service.description}</p>
				</a>
			))}
		</div>
	</div>
</section>
