---
import { Image } from 'astro:assets';
import logo from '../assets/company-logo.png';

interface Props {
	class?: string;
	priority?: boolean;
}

const { class: className = '', priority = false } = Astro.props;
---

<Image
	src={logo}
	alt="Matome SoftTech Solutions"
	width={440}
	height={132}
	fit="cover"
	position="center"
	format="webp"
	quality={90}
	loading={priority ? 'eager' : 'lazy'}
	class:list={['block rounded-lg bg-white object-cover', className]}
/>
