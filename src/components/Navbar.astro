---
import BrandLogo from './BrandLogo.astro';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
	{ label: 'Home', href: '/', route: '/' },
	{ label: 'LabourGuard', href: '/labourguard', route: '/labourguard' },
	{ label: 'PowerGuard', href: '/powerguard', route: '/powerguard' },
	{ label: 'Services', href: '/services', route: '/services' },
	{ label: 'About', href: '/about', route: '/about' },
	{ label: 'Contact Us', href: '/contact', route: '/contact' },
];

const ctaLabel = pathname === '/powerguard' ? 'Get a Quote' : 'Request a Demo';
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur-md">
	<nav class="section-shell flex h-20 items-center justify-between" aria-label="Main navigation">
		<a href="/" class="shrink-0" aria-label="Matome SoftTech Solutions home">
			<BrandLogo priority class="h-auto w-[190px] sm:w-[220px]" />
		</a>

		<div class="hidden items-center gap-1 lg:flex">
			{links.map((link) => {
				const active = pathname === link.route;
				return (
					<a href={link.href} class:list={['relative px-3 py-2 text-sm font-semibold transition-colors hover:text-sky-600', active ? 'text-sky-600 after:absolute after:inset-x-3 after:-bottom-1 after:h-0.5 after:rounded-full after:bg-sky-500' : 'text-slate-600']} aria-current={active ? 'page' : undefined}>
						{link.label}
					</a>
				);
			})}
		</div>

		<a href="/contact" class="hidden rounded-full bg-slate-950 px-5 py-3 text-sm font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-sky-700 hover:shadow-lg md:inline-flex">{ctaLabel}</a>

		<details class="group relative lg:hidden">
			<summary class="grid size-11 cursor-pointer list-none place-items-center rounded-full border border-slate-200 text-slate-900 marker:content-none" aria-label="Open navigation menu">
				<svg viewBox="0 0 24 24" class="size-5 group-open:hidden" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/></svg>
				<svg viewBox="0 0 24 24" class="hidden size-5 group-open:block" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke-linecap="round"/></svg>
			</summary>
			<div class="absolute right-0 top-14 w-64 rounded-2xl border border-slate-200 bg-white p-3 shadow-2xl">
				{links.map((link) => {
					const active = pathname === link.route;
					return <a href={link.href} class:list={['block rounded-xl px-4 py-3 text-sm font-semibold', active ? 'bg-sky-50 text-sky-700 underline decoration-2 underline-offset-4' : 'text-slate-700 hover:bg-sky-50 hover:text-sky-700']} aria-current={active ? 'page' : undefined}>{link.label}</a>;
				})}
				<a href="/contact" class="mt-2 block rounded-xl bg-slate-950 px-4 py-3 text-center text-sm font-bold text-white">{ctaLabel}</a>
			</div>
		</details>
	</nav>
</header>
